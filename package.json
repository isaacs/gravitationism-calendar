{
  "name": "gravitationism-calendar",
  "version": "1.0.6",
  "type": "module",
  "files": [
    "bin",
    "dist"
  ],
  "devDependencies": {
    "@ts-ics/schema-zod": "^2.0.0",
    "@types/node": "^22.13.17",
    "ics": "^3.8.1",
    "prettier": "^3.8.1",
    "ts-ics": "^2.1.0",
    "typedoc": "^0.28.17"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "bin": {
    "gravdate": "./bin/gravdate.js"
  },
  "tshy": {
    "dialects": [
      "esm"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "scripts": {
    "typedoc": "typedoc",
    "prepare": "tshy",
    "postprepare": "mkdir -p dist/data; cp data/* dist/data",
    "postversion": "npm publish",
    "prepublish": "npm run prepare",
    "preversion": "npm run prepare",
    "prepublishOnly": "git push origin --follow-tags",
    "format": "prettier --write .",
    "parse-solar": "tshy && node dist/esm/parse-solar.js",
    "parse-lunar": "tshy && node dist/esmparse-lunar.js",
    "solar-ics": "tshy && node dist/esmgen-ics.js",
    "lunar-ics": "tshy && node dist/esmgen-ics.js months",
    "gdate": "tshy && node dist/esm/current-gdate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/isaacs/gravitationism-calendar.git"
  },
  "dependencies": {
    "tshy": "^4.1.3"
  },
  "module": "./dist/esm/index.js"
}
